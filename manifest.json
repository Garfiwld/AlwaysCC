{
  "manifest_version": 3,
  "name": "AlwaysCC",
  "version": "1.0",
  "description": "Automatically enables subtitles on YouTube videos and selects your preferred caption type",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "AlwaysCC",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "src/state.js",
        "src/menu.js",
        "src/subtitles.js",
        "src/audiotrack.js",
        "src/apply.js",
        "src/storage.js",
        "src/main.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "alwayscc@firefox-extensions.com",
      "strict_min_version": "109.0"
    }
  },
  "author": "oop7",
  "homepage_url": "https://github.com/oop7/AlwaysCC"
}
